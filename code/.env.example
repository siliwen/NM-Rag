# ===== 大模型（唯一需要联网与付费的环节）=====
# 阿里云百炼 / 腾讯云 / 学校自建云，均为 OpenAI 兼容接口
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60

# ===== 检索（RAG 的核心，权重最高）=====
# hash        = 零依赖测试桩，**没有语义能力**，只用于跑单元测试
# bge-small-zh= 24M 参数 / 512 维，CPU 流畅（开发期默认）
# bge-base-zh = 102M / 768 维，质量更好，CPU 稍慢
# bge-m3      = 568M / 1024 维，多语言，生产期用（GPU 优先）
# 也可直接填 HuggingFace 模型 ID（形如 BAAI/bge-m3）
EMBEDDER=bge-small-zh
# 留空 = 自动选择（有 CUDA 用 GPU，否则 CPU）；可填 cpu / cuda / cuda:0
EMBEDDER_DEVICE=
# 国内直连 huggingface.co 不通，默认走镜像；有专线时可改成 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

RETRIEVE_TOP_K=3
RETRIEVE_CANDIDATES=10
# 关键词（BM25）权重：0.6 = 偏字面，非遗专名多，宁可偏关键词
KEYWORD_WEIGHT=0.6

# ===== 存储 =====
# sqlite = 持久化（生产默认，落地到 code/data/index/knowledge.db）
# memory = 内存（测试用，重启即丢）
# 换过 EMBEDDER 不用手动清库：启动时会用原文自动重算全部向量
VECTOR_STORE=sqlite

# ===== 渲染引擎（LiveTalking）=====
AVATAR_BASE_URL=http://127.0.0.1:8010
AVATAR_AVATAR_ID=wav2lip256_avatar1
AVATAR_TIMEOUT=15

# ===== 服务 =====
HOST=0.0.0.0
PORT=8020
LOG_LEVEL=INFO
