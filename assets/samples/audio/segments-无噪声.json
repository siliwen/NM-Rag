{
  "source": "模拟口述史-皮影戏-无噪声.wav",
  "duration_ms": 149685,
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1410,
      "text": "我叫王守义，",
      "speaker": null
    },
    {
      "start_ms": 1910,
      "end_ms": 3330,
      "text": "今年六十七了，",
      "speaker": null
    },
    {
      "start_ms": 3730,
      "end_ms": 5250,
      "text": "家住陕西化县，",
      "speaker": null
    },
    {
      "start_ms": 5790,
      "end_ms": 8650,
      "text": "就是现在叫渭南市华州区。",
      "speaker": null
    },
    {
      "start_ms": 9910,
      "end_ms": 14270,
      "text": "我们家唱皮影戏到我这一辈是第四代。",
      "speaker": null
    },
    {
      "start_ms": 15470,
      "end_ms": 18170,
      "text": "我十一岁那年跟着我爹学，",
      "speaker": null
    },
    {
      "start_ms": 18690,
      "end_ms": 20430,
      "text": "那时候不叫学艺，",
      "speaker": null
    },
    {
      "start_ms": 20870,
      "end_ms": 21630,
      "text": "叫帮忙。",
      "speaker": null
    },
    {
      "start_ms": 22210,
      "end_ms": 25705,
      "text": "先是在后台第千子剪影人，",
      "speaker": null
    },
    {
      "start_ms": 28200,
      "end_ms": 31920,
      "text": "皮影系的影人是用牛皮刻出来的。",
      "speaker": null
    },
    {
      "start_ms": 33140,
      "end_ms": 36119,
      "text": "选皮要选三碎口的黄牛皮，",
      "speaker": null
    },
    {
      "start_ms": 36620,
      "end_ms": 38200,
      "text": "太老的皮子发脆，",
      "speaker": null
    },
    {
      "start_ms": 38740,
      "end_ms": 47360,
      "text": "太嫩的又立不住皮子泡软了以后要刮刮到能透光薄得跟纸一样，",
      "speaker": null
    },
    {
      "start_ms": 47820,
      "end_ms": 55140,
      "text": "还不能破刮皮这个活儿最见功夫刮上一用劲就刮穿了，",
      "speaker": null
    },
    {
      "start_ms": 55560,
      "end_ms": 56820,
      "text": "破了就废了。",
      "speaker": null
    },
    {
      "start_ms": 58020,
      "end_ms": 60360,
      "text": "刮好的皮子绷在木框上，",
      "speaker": null
    },
    {
      "start_ms": 60380,
      "end_ms": 60925,
      "text": "硬干，",
      "speaker": null
    },
    {
      "start_ms": 61450,
      "end_ms": 63305,
      "text": "干透了才能画稿子。",
      "speaker": null
    },
    {
      "start_ms": 65790,
      "end_ms": 68535,
      "text": "画稿子讲究一个线条连贯，",
      "speaker": null
    },
    {
      "start_ms": 69030,
      "end_ms": 69990,
      "text": "一笔下去，",
      "speaker": null
    },
    {
      "start_ms": 69990,
      "end_ms": 72860,
      "text": "不能断刻的时候，",
      "speaker": null
    },
    {
      "start_ms": 72880,
      "end_ms": 74705,
      "text": "手里握着十几把刀，",
      "speaker": null
    },
    {
      "start_ms": 75200,
      "end_ms": 77045,
      "text": "刀口宽窄都不一样。",
      "speaker": null
    },
    {
      "start_ms": 77530,
      "end_ms": 82375,
      "text": "可头发丝用最细的那把可一个五升，",
      "speaker": null
    },
    {
      "start_ms": 82860,
      "end_ms": 87670,
      "text": "光是脸谱上的花纹就要一天功夫刻。",
      "speaker": null
    },
    {
      "start_ms": 87670,
      "end_ms": 90925,
      "text": "完了要染色颜料是矿物的，",
      "speaker": null
    },
    {
      "start_ms": 91360,
      "end_ms": 93850,
      "text": "用桐油吊开染一遍，",
      "speaker": null
    },
    {
      "start_ms": 93930,
      "end_ms": 94615,
      "text": "晾一遍，",
      "speaker": null
    },
    {
      "start_ms": 95140,
      "end_ms": 97025,
      "text": "前后要染七八遍，",
      "speaker": null
    },
    {
      "start_ms": 98280,
      "end_ms": 101530,
      "text": "最后一道是上游上了游影，",
      "speaker": null
    },
    {
      "start_ms": 101650,
      "end_ms": 102625,
      "text": "人才透亮，",
      "speaker": null
    },
    {
      "start_ms": 103150,
      "end_ms": 103590,
      "text": "灯光。",
      "speaker": null
    },
    {
      "start_ms": 103590,
      "end_ms": 105620,
      "text": "益达红是红绿，",
      "speaker": null
    },
    {
      "start_ms": 105620,
      "end_ms": 109610,
      "text": "是绿唱戏的调子，",
      "speaker": null
    },
    {
      "start_ms": 109610,
      "end_ms": 110665,
      "text": "是婉婉腔，",
      "speaker": null
    },
    {
      "start_ms": 111180,
      "end_ms": 113895,
      "text": "乐器简单九一把乐琴，",
      "speaker": null
    },
    {
      "start_ms": 114440,
      "end_ms": 120045,
      "text": "一副帮子一个碗碗碗碗就是个小铜碗，",
      "speaker": null
    },
    {
      "start_ms": 120560,
      "end_ms": 123145,
      "text": "拿筷子敲声音清脆，",
      "speaker": null
    },
    {
      "start_ms": 123710,
      "end_ms": 125325,
      "text": "所以叫婉婉枪。",
      "speaker": null
    },
    {
      "start_ms": 126710,
      "end_ms": 129185,
      "text": "一个人能唱好几个角色，",
      "speaker": null
    },
    {
      "start_ms": 129660,
      "end_ms": 131425,
      "text": "男的女的都得会，",
      "speaker": null
    },
    {
      "start_ms": 131870,
      "end_ms": 134925,
      "text": "嗓子要能翻上去也能压下来。",
      "speaker": null
    },
    {
      "start_ms": 136260,
      "end_ms": 139205,
      "text": "现在年轻人愿意学的不多了，",
      "speaker": null
    },
    {
      "start_ms": 139640,
      "end_ms": 141275,
      "text": "我带了三个徒弟，",
      "speaker": null
    },
    {
      "start_ms": 141740,
      "end_ms": 143375,
      "text": "最长的学了六年，",
      "speaker": null
    },
    {
      "start_ms": 144670,
      "end_ms": 148855,
      "text": "我就想着这门手艺不能在我手上断了。",
      "speaker": null
    }
  ]
}